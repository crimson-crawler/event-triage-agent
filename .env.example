# ---- Crimson Crawler (required, both backends) ----
# Your CC API key. Sent as the `X-API-Key` header on /v1/enrich/* calls.
CRIMSON_CRAWLER_API_KEY=
# Override only if you use a non-default CC endpoint.
CRIMSON_CRAWLER_BASE_URL=https://crimsoncrawler.com/

# ---- LLM (OpenAI-compatible) ----
# Any OpenAI-compatible provider. For Azure OpenAI or a local server
# (Ollama, LM Studio, vLLM), set OPENAI_BASE_URL to its endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1     # e.g. Ollama
# Per-request timeout in seconds (default 60). Raise for slow local hardware.
# OPENAI_TIMEOUT=60

# ---- Egress guard (optional) ----
# Extra DNS zones to treat as internal, so indicators in them are never sent for
# enrichment. Comma-separated. Reserved IP ranges, bare hostnames, and the
# conventional private zones (.local, .internal, .corp, ...) are always refused.
# CC_INTERNAL_SUFFIXES=acme.example,ad.acme.example

# ---- .env discovery (optional) ----
# This file is loaded only from exactly ./.env — never from a parent directory.
# Set CC_DOTENV to load a specific file from elsewhere instead.
# CC_DOTENV=/path/to/your.env

# ---- Base URL safety (optional) ----
# Both base URLs above must be https://, or loopback http:// (Ollama, LM Studio).
# Set to 1 to allow plain http:// to a non-loopback CRIMSON_CRAWLER_BASE_URL /
# OPENAI_BASE_URL — the API key then travels in cleartext, so only do this over
# a link you already trust (e.g. an internal VPN to a self-hosted model).
# CC_ALLOW_INSECURE_CC_URL=1
# CC_ALLOW_INSECURE_OPENAI_URL=1
